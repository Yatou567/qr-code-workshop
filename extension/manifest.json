{
  "manifest_version": 3,
  "name": "二维码工坊 · 网页链接助手",
  "version": "1.0.0",
  "description": "自动读取当前网页及页面链接，悬停预览二维码，也支持输入文字和下载图片。全部本地生成。",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_popup": "popup.html", "default_title": "二维码工坊", "default_icon": {"16":"icons/16.png", "32":"icons/32.png"}},
  "icons": {"16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png"}
}
